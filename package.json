{
  "name": "dsh-local-saver",
  "version": "0.4.1",
  "private": false,
  "description": "Local, key-safe tool-output compressor for DeepSeek Harness (dsh). No proxy, no network calls, no credential access.",
  "type": "module",
  "main": "index.js",
  "exports": { ".": "./index.js", "./package.json": "./package.json" },
